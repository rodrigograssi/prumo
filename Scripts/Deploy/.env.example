# Arquivo de exemplo de variáveis de ambiente para PesquisaX
# Copie este arquivo para .env e configure as variáveis conforme necessário

# ======================================
# INFORMAÇÕES DE BUILD
# ======================================
BUILD_NUMBER=local
GIT_COMMIT_HASH=development

# ======================================
# CONFIGURAÇÕES DE DOMÍNIO
# ======================================
# Altere estes domínios para seus domínios reais em produção
DOMAIN_WEB=pesquisax.local
DOMAIN_API=api.pesquisax.local
DOMAIN_DB_ADMIN=db.pesquisax.local

# ======================================
# CONFIGURAÇÕES DE SSL/TLS
# ======================================
# Certificado SSL (Let's Encrypt resolver name)
TLS_CERT_RESOLVER=letsencrypt

# ======================================
# CONFIGURAÇÕES DE TRAEFIK
# ======================================
# Entrypoint do Traefik (normalmente websecure para HTTPS)
TRAEFIK_ENTRYPOINT=websecure

# ======================================
# CONFIGURAÇÕES DE RECURSOS
# ======================================
# Limites de CPU e Memória para os serviços

# API
API_CPU_LIMIT=0.5
API_MEMORY_LIMIT=512M
API_CPU_RESERVATION=0.25
API_MEMORY_RESERVATION=256M

# Web
WEB_CPU_LIMIT=0.3
WEB_MEMORY_LIMIT=256M
WEB_CPU_RESERVATION=0.15
WEB_MEMORY_RESERVATION=128M

# Database
DB_CPU_LIMIT=0.5
DB_MEMORY_LIMIT=512M
DB_CPU_RESERVATION=0.25
DB_MEMORY_RESERVATION=256M

# ======================================
# CONFIGURAÇÕES DE BANCO DE DADOS
# ======================================
POSTGRES_DB=pesquisax
POSTGRES_USER=pesquisax
# A senha será lida do Docker Secret: pesquisax_postgres_password

# ======================================
# CONFIGURAÇÕES DE JWT
# ======================================
JWT_ISSUER=PesquisaX
JWT_AUDIENCE=PesquisaX.Users
JWT_EXPIRATION_HOURS=24
# A chave secreta será lida do Docker Secret: pesquisax_jwt_secret

# ======================================
# CONFIGURAÇÕES DE LOG
# ======================================
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_ASPNETCORE=Warning

# ======================================
# CONFIGURAÇÕES DE DEPLOY
# ======================================
# Número de réplicas para cada serviço
API_REPLICAS=2
WEB_REPLICAS=2
DB_REPLICAS=1

# Estratégia de update
UPDATE_PARALLELISM=1
UPDATE_DELAY=10s
UPDATE_ORDER=start-first
UPDATE_FAILURE_ACTION=rollback

# ======================================
# CONFIGURAÇÕES DE BACKUP
# ======================================
# Habilitar serviço de backup automático do PostgreSQL
ENABLE_DB_BACKUP=true
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_HOURS=6

# ======================================
# FERRAMENTAS OPCIONAIS
# ======================================
# Habilitar Adminer para administração do banco
ENABLE_ADMINER=true

# ======================================
# CONFIGURAÇÕES DE CORS
# ======================================
# Origens permitidas para CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=https://pesquisax.local,https://www.pesquisax.local

# ======================================
# CONFIGURAÇÕES DE HEALTH CHECK
# ======================================
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=60s

# ======================================
# CONFIGURAÇÕES DE REDE
# ======================================
# Nome da rede externa do Traefik
TRAEFIK_NETWORK=traefik
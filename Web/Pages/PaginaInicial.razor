@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@layout AuthLayout
@inject NavigationManager Navigation

@attribute [AllowAnonymous]

<PageTitle>PesquisaX - Sistema de Pesquisas</PageTitle>

<!-- Hero Section -->
<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudPaper Elevation="2" Class="pa-8 text-center mb-6">
        <MudText Typo="Typo.h2" Color="Color.Primary" GutterBottom="true">
            <MudIcon Icon="@Icons.Material.Filled.Assessment" Size="Size.Large" Class="mr-3" />
            PesquisaX
        </MudText>
        <MudText Typo="Typo.h5" Color="Color.Secondary" Class="mb-4">
            Sistema de Pesquisas com Gráfico Radar
        </MudText>
        <MudText Typo="Typo.body1" Class="mb-6" Style="max-width: 600px; margin: 0 auto;">
            Crie pesquisas personalizadas, aplique-as durante meetings e visualize os resultados
            através de gráficos radar comparativos. Ideal para avaliações de equipe, feedback
            de projetos e análises comportamentais.
        </MudText>

        <AuthorizeView>
            <Authorized>
                <MudButton Variant="Variant.Filled"
                          Color="Color.Primary"
                          Size="Size.Large"
                          StartIcon="@Icons.Material.Filled.Dashboard"
                          OnClick="IrParaHome">
                    Ir para o Dashboard
                </MudButton>
                <MudText Typo="Typo.body2" Class="mt-3">
                    Bem-vindo de volta, @context.User.Identity!.Name!
                </MudText>
            </Authorized>
            <NotAuthorized>
                <MudStack Row Justify="Justify.Center" Spacing="3">
                    <MudButton Variant="Variant.Filled"
                              Color="Color.Primary"
                              Size="Size.Large"
                              StartIcon="@Icons.Material.Filled.Login"
                              Href="/login">
                        Entrar no Sistema
                    </MudButton>
                </MudStack>
            </NotAuthorized>
        </AuthorizeView>
    </MudPaper>

    <!-- Features Section -->
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="1" Class="pa-6 h-100">
                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.Create" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h6" Align="Align.Center">Criar Pesquisas</MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center">
                        Monte suas pesquisas com grupos de perguntas organizados por categorias
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Elevation="1" Class="pa-6 h-100">
                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Typo="Typo.h6" Align="Align.Center">Aplicar Durante Meetings</MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center">
                        Use as pesquisas em tempo real para avaliar pessoas e situações
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Elevation="1" Class="pa-6 h-100">
                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Large" Color="Color.Tertiary" />
                    <MudText Typo="Typo.h6" Align="Align.Center">Visualizar Resultados</MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center">
                        Compare resultados com gráficos radar intuitivos e detalhados
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private void IrParaHome()
    {
        Navigation.NavigateTo("/home");
    }
}
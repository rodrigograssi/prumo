@page "/primeiro-usuario"
@layout AuthLayout
@using PesquisaX.Shared.DTO.Requestes
@using MudBlazor
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IAuthService AuthService

<PageTitle>Primeiro Acesso - PesquisaX</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="mr-3" Color="Color.Primary" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.h5">Bem-vindo ao PesquisaX!</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Configure o primeiro usuário administrador
                        </MudText>
                    </div>
                </div>
            </CardHeaderContent>
        </MudCardHeader>
        
        <MudForm @ref="form">
            <MudCardContent>
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    <MudText>
                        <strong>Primeiro acesso:</strong> Crie sua conta de administrador para começar a usar o sistema.
                        Após criar esta conta, o gerenciamento de usuários será feito dentro da aplicação.
                    </MudText>
                </MudAlert>
                
                <MudTextField @bind-Value="registroRequest.Nome"
                             Label="Nome Completo"
                             Variant="Variant.Outlined"
                             Required="true"
                             RequiredError="Nome é obrigatório"
                             Counter="100"
                             MaxLength="100"
                             Class="mb-4" />
                
                <MudTextField @bind-Value="registroRequest.Email"
                             Label="Email"
                             Variant="Variant.Outlined"
                             InputType="InputType.Email"
                             Required="true"
                             RequiredError="Email é obrigatório"
                             Validation="@(new EmailAddressAttribute() {ErrorMessage = "Email deve ter um formato válido"})"
                             Class="mb-4" />
                
                <MudTextField @bind-Value="registroRequest.Senha"
                             Label="Senha"
                             Variant="Variant.Outlined"
                             InputType="InputType.Password"
                             Required="true"
                             RequiredError="Senha é obrigatória"
                             Validation="@(new Func<string, string?>(ValidarSenha))"
                             Class="mb-4" />
                
                <MudTextField @bind-Value="registroRequest.ConfirmarSenha"
                             Label="Confirmar Senha"
                             Variant="Variant.Outlined"
                             InputType="InputType.Password"
                             Required="true"
                             RequiredError="Confirmação de senha é obrigatória"
                             Validation="@(new Func<string, string?>(ValidarConfirmacaoSenha))"
                             Class="mb-4" />
            </MudCardContent>
            
            <MudCardActions Class="pa-4">
                <MudButton OnClick="CriarPrimeiroUsuario"
                          Variant="Variant.Filled"
                          Color="Color.Primary"
                          Size="Size.Large"
                          FullWidth="true"
                          Disabled="carregando">
                    @if (carregando)
                    {
                        <MudProgressCircular Class="ms-n1 mr-2" Size="Size.Small" Indeterminate="true"/>
                        <span>Criando conta...</span>
                    }
                    else
                    {
                        <span>Criar Conta e Entrar no Sistema</span>
                    }
                </MudButton>
            </MudCardActions>
        </MudForm>
    </MudCard>
</MudContainer>

@code {
    private MudForm form = new();
    private RegistroRequest registroRequest = new();
    private bool carregando = false;

    protected override async Task OnInitializedAsync()
    {
        // Verificar se já está autenticado
        if (await AuthService.EstaAutenticadoAsync())
        {
            Navigation.NavigateTo("/home", replace: true);
            return;
        }

        // Verificar se já existem usuários
        var existemUsuarios = await AuthService.ExistemUsuariosAsync();
        if (existemUsuarios)
        {
            // Se já existem usuários, redirecionar para login
            Navigation.NavigateTo("/", replace: true);
        }
    }

    private async Task CriarPrimeiroUsuario()
    {
        await form.Validate();
        if (!form.IsValid) return;

        carregando = true;
        StateHasChanged();

        try
        {
            var response = await AuthService.RegistroAsync(registroRequest);
            
            if (response.Sucesso)
            {
                Snackbar.Add($"Bem-vindo, {registroRequest.Nome}! Conta criada com sucesso.", Severity.Success);
                Navigation.NavigateTo("/home", replace: true);
            }
            else
            {
                Snackbar.Add(response.Mensagem, Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Erro ao criar conta. Tente novamente.", Severity.Error);
        }
        finally
        {
            carregando = false;
            StateHasChanged();
        }
    }

    private string? ValidarSenha(string senha)
    {
        if (string.IsNullOrWhiteSpace(senha))
            return "Senha é obrigatória";
        
        if (senha.Length < 6)
            return "Senha deve ter no mínimo 6 caracteres";
        
        return null;
    }

    private string? ValidarConfirmacaoSenha(string confirmacao)
    {
        if (string.IsNullOrWhiteSpace(confirmacao))
            return "Confirmação de senha é obrigatória";
        
        if (confirmacao != registroRequest.Senha)
            return "Senhas não conferem";
        
        return null;
    }
}
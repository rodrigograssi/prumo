@page "/registro"
@layout AuthLayout
@using PesquisaX.Shared.Comandos
@using PesquisaX.Shared.DTO.Requestes

@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject ApiController<dynamic> ApiController

<PageTitle>Registrar - PesquisaX</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="mr-3" />
                <MudText Typo="Typo.h5">Criar Nova Conta</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        
        <MudForm @ref="_form">
            <MudCardContent>
                <MudTextField @bind-Value="_comando.Nome"
                             Label="Nome Completo"
                             Variant="Variant.Outlined"
                             Required="true"
                             RequiredError="Nome é obrigatório"
                             Counter="100"
                             MaxLength="100"
                             Class="mb-4" />
                
                <MudTextField @bind-Value="_comando.Email"
                             Label="Email"
                             Variant="Variant.Outlined"
                             InputType="InputType.Email"
                             Required="true"
                             RequiredError="Email é obrigatório"
                             Validation="@(new EmailAddressAttribute() {ErrorMessage = "Email deve ter um formato válido"})"
                             Class="mb-4" />
                
                <MudTextField @bind-Value="_comando.Senha"
                             Label="Senha"
                             Variant="Variant.Outlined"
                             InputType="InputType.Password"
                             Required="true"
                             RequiredError="Senha é obrigatória"
                             Validation="@(new Func<string, string?>(ValidarSenha))"
                             Class="mb-4" />
                
                <MudTextField @bind-Value="_comando.ConfirmarSenha"
                             Label="Confirmar Senha"
                             Variant="Variant.Outlined"
                             InputType="InputType.Password"
                             Required="true"
                             RequiredError="Confirmação de senha é obrigatória"
                             Validation="@(new Func<string, string?>(ValidarConfirmacaoSenha))"
                             Class="mb-4" />
            </MudCardContent>
            
            <MudCardActions Class="pa-4">
                <MudButton OnClick="RealizarRegistro"
                          Variant="Variant.Filled"
                          Color="Color.Primary"
                          Size="Size.Large"
                          FullWidth="true"
                          Disabled="_carregando">
                    @if (_carregando)
                    {
                        <MudProgressCircular Class="ms-n1 mr-2" Size="Size.Small" Indeterminate="true"/>
                        <span>Criando conta</span>
                    }
                    else
                    {
                        <span>Criar Conta</span>
                    }
                </MudButton>
            </MudCardActions>
        </MudForm>
        
        <MudCardContent Class="pa-4 pt-0">
            <MudDivider Class="mb-4" />
            <MudText Align="Align.Center" Class="mb-2">
                Já tem uma conta?
            </MudText>
            <MudButton Href="/login"
                      Variant="Variant.Text"
                      Color="Color.Secondary"
                      FullWidth="true">
                Fazer Login
            </MudButton>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private MudForm _form = new();
    private readonly UsuarioCrud _comando = new();
    private bool _carregando = false;

    protected override async Task OnInitializedAsync()
    {
        // Verificar se já está autenticado
        if (await AuthService.EstaAutenticadoAsync())
        {
            Navigation.NavigateTo("/home", replace: true);
            return;
        }
    }

    private async Task RealizarRegistro()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        _carregando = true;
        StateHasChanged();
        try
        {
            var retorno = await ApiController.PostAsync(_comando, "api/auth/registro");
            
            if (retorno.Sucesso)
            {
                Snackbar.Add(retorno.Mensagem, Severity.Success);
                Navigation.NavigateTo("/home", replace: true);
            }
            else
            {
                Snackbar.Add(retorno.Mensagem, Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Erro ao criar conta. Tente novamente.", Severity.Error);
        }
        finally
        {
            _carregando = false;
            StateHasChanged();
        }
    }

    private string? ValidarSenha(string senha)
    {
        if (string.IsNullOrWhiteSpace(senha))
            return "Senha é obrigatória";
        
        if (senha.Length < 6)
            return "Senha deve ter no mínimo 6 caracteres";
        
        return null;
    }

    private string? ValidarConfirmacaoSenha(string confirmacao)
    {
        if (string.IsNullOrWhiteSpace(confirmacao))
            return "Confirmação de senha é obrigatória";
        
        if (confirmacao != _comando.Senha)
            return "Senhas não conferem";
        
        return null;
    }
}
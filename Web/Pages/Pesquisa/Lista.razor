@page "/pesquisas"
@using PesquisaX.Shared.Views

@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@inject ApiControllerGenerico ApiController

<PageTitle>Lista de Pesquisas</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4">Minhas Pesquisas</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="Icons.Material.Filled.Add"
                       Href="/criar-pesquisa">
                Nova Pesquisa
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (_pesquisas == null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_pesquisas.Count == 0)
    {
        <MudPaper Elevation="1" Class="pa-8 text-center">
            <MudIcon Icon="Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
            <MudText Typo="Typo.h6" Class="mb-2">Nenhuma pesquisa encontrada</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                Crie sua primeira pesquisa para começar
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="Icons.Material.Filled.Add"
                       Href="/criar-pesquisa">
                Criar Primeira Pesquisa
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            @foreach (var pesquisa in _pesquisas)
            {
                <MudItem xs="12" md="6" lg="4">
                    <MudCard Elevation="2" Class="h-100">
                        <MudCardContent>
                            <MudStack>
                                <MudText Typo="Typo.h6">@pesquisa.Nome</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Criado em: @pesquisa.DataCriacao.ToString("dd/MM/yyyy")
                                </MudText>
                                <MudDivider />
                                <MudStack Row>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                                        @pesquisa.TotalDePerguntas perguntas
                                    </MudChip>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">
                                        @pesquisa.TotalDeRespostas aplicações
                                    </MudChip>
                                </MudStack>
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions>
                            <MudStack Spacing="1">
                                <MudStack Row Spacing="1">
                                    <MudButton StartIcon="@Icons.Material.Filled.PlayArrow" Color="Color.Primary"
                                               Variant="Variant.Filled" Size="Size.Small" FullWidth="true"
                                               OnClick="() => ApplyPesquisa(pesquisa.PublicId)">
                                        Aplicar
                                    </MudButton>
                                    <MudButton StartIcon="@Icons.Material.Filled.Edit" Color="Color.Secondary"
                                               Variant="Variant.Outlined" Size="Size.Small" FullWidth="true"
                                               OnClick="() => EditPesquisa(pesquisa.PublicId)">
                                        Editar
                                    </MudButton>
                                </MudStack>
                                <MudStack Row Spacing="1">
                                    <MudButton StartIcon="@Icons.Material.Filled.Assessment" Color="Color.Info"
                                               Variant="Variant.Text" Size="Size.Small" FullWidth="true"
                                               OnClick="() => ViewResultados(pesquisa.PublicId)"
                                               Disabled="@(pesquisa.TotalDeRespostas == 0)">
                                        Resultados
                                    </MudButton>
                                    <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                               Variant="Variant.Text" Size="Size.Small" FullWidth="true"
                                               OnClick="() => DeletePesquisa(pesquisa)">
                                        Excluir
                                    </MudButton>
                                </MudStack>
                            </MudStack>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private List<PesquisaListaView>? _pesquisas;

    protected override async Task OnInitializedAsync()
    {
        await LoadPesquisas();
    }

    private async Task LoadPesquisas()
    {
        var retorno = await ApiController.GetAsync<List<PesquisaListaView>>("/api/Pesquisas");
        if (retorno.Sucesso || retorno.Data != null)
            _pesquisas = retorno.Data;
        else
        {
            Snackbar.Add(retorno.Mensagem, Severity.Error);
        }
    }

    private void ApplyPesquisa(Guid pesquisaId)
    {
        Navigation.NavigateTo($"/aplicar-pesquisa/{pesquisaId}");
    }

    private void EditPesquisa(Guid pesquisaId)
    {
        Navigation.NavigateTo($"/editar-pesquisa/{pesquisaId}");
    }

    private void ViewResultados(Guid pesquisaId)
    {
        Navigation.NavigateTo($"/resultados/{pesquisaId}");
    }

    private async Task DeletePesquisa(PesquisaListaView pesquisva)
    {
        bool? result = await DialogService.ShowMessageBox(
            "Confirmar Exclusão",
            $"Tem certeza que deseja excluir a pesquisa '{pesquisva.Nome}'? Esta ação não pode ser desfeita.",
            yesText:"Excluir",
            cancelText:"Cancelar");

        if (result == true)
        {
            await ApiController.DeleteAsync($"api/Pesquisas", pesquisva.PublicId.ToString()); 
            await LoadPesquisas();
            Snackbar.Add("Pesquisa excluída com sucesso", Severity.Success);
        }
    }
}


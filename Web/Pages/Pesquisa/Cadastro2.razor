@page "/criar-pesquisa"
@page "/editar-pesquisa/{PesquisaId:guid}"
@using PesquisaX.Shared.Comandos
@using PesquisaX.Shared.Views

@inject IServicoPesquisa ServicoPesquisa
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ApiController<PesquisaView> ApiPesquisa
@inject ApiController<GrupoQuestaoView> ApiGrupoQuestao
@inject ApiController<QuestaoView> ApiQuestao

<PageTitle>@(IsEditing ? "Editar Pesquisa" : "Criar Nova Pesquisa")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <MudForm @ref="_form" Model="_pesquisa" @bind-IsValid="_formIsValid"> 
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudTextField T="string" Label="Nome da Pesquisa" 
                          @bind-Value="_pesquisa.Nome" 
                          Required="true"
                          Variant="Variant.Outlined" 
                          Class="mb-4" />
            
            <MudButtonGroup>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           Disabled="@(!_formIsValid || _pesquisa.GruposQuestoes.Count == 0)"
                           OnClick="SalvarPesquisa">
                    @(IsEditing ? "Salvar Alterações" : "Criar Pesquisa")
                </MudButton>
            </MudButtonGroup>
        </MudPaper>
    </MudForm>
</MudContainer>

@if (IsEditing)
{
    foreach (var group in _gruposQuestao)
    {
        <MudPaper Elevation="2" Class="pa-4 mb-4" Style="background: linear-gradient(135deg, #f8f9ff 0%, #e3f2fd 100%); border-left: 4px solid #2196f3;">
            <MudStack>
                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">Grupo de Perguntas</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                   Color="Color.Error" 
                                   Size="Size.Small"
                                   OnClick="() => RemoveGroup(group)" />
                </MudStack>
            
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" Label="Nome do Grupo" 
                                      @bind-Value="group.Nome" 
                                      Required="true"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" Label="Categoria (para gráfico)" 
                                      @bind-Value="group.Categoria" 
                                      Required="true"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        @* <MudTextField T="string" Label="Cor (Hex)"  *@
                        @*             @bind-Value="group.Cor"  *@
                        @*             Variant="Variant.Outlined" *@
                        @*             Placeholder="#FF6B6B" /> *@
                        <MudColorPicker
                            Label="Cor do grupo"
                            @bind-Text="group.Cor"
                            Placeholder="Selecione uma cor"
                            ShowInputs="false"
                            ShowToolbar="true"
                            ShowAlpha="false"
                        />
                    </MudItem>
                </MudGrid>
                
                <MudDivider Class="my-2" />
                    
                <MudText Typo="Typo.subtitle1">Perguntas:</MudText>
                    
                @foreach (var questao in _questoes)
                {
                    <MudPaper Elevation="0" Class="pa-3 mb-2" Style="border: 1px dashed #ddd;">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudTextField T="string" Label="Pergunta" 
                                          @bind-Value="questao.Texto" 
                                          Required="true"
                                          Variant="Variant.Text" 
                                          Style="flex-grow: 1; margin-right: 16px;" />
                                            
                            <MudCheckBox T="bool" Label="Escala Invertida (10 = ruim)" 
                                         @bind-Value="questao.EInvertida" 
                                         Color="Color.Primary" />
                                           
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                           Color="Color.Error" 
                                           Size="Size.Small"
                                           OnClick="() => RemoveQuestao(group, questao)" />
                        </MudStack>
                    </MudPaper>
                }
                
                
                <MudButton Variant="Variant.Text" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="() => AdicionarQuestao(group)">
                    Adicionar Pergunta
                </MudButton>
            </MudStack>
        </MudPaper>
    }
}

@code {
    [Parameter] public Guid? PesquisaId { get; set; }
    
    private bool IsEditing => PesquisaId.HasValue;
    private MudForm _form = new();
    private bool _formIsValid;
    
    private PesquisaView _pesquisa = new();
    
    private List<GrupoQuestaoCrud> _gruposQuestao = [];
    private List<QuestaoCrud> _questoes = [];

    protected override async Task OnInitializedAsync()
    {
        await CarregarPesquisa();
    }

    private async Task<bool> CarregarPesquisa()
    {
        if (!IsEditing || !PesquisaId.HasValue) return false;
        
        var retorno = await ApiPesquisa.GetAsync($"api/pesquisa/{PesquisaId}");
        if (!retorno.Sucesso)
        {
            Snackbar.Add(retorno.Mensagem, Severity.Error);
            return false;
        }

        _pesquisa = retorno.Data!;
        
        return true;
    }

    private async Task SalvarPesquisa()
    {
        var comando = new PesquisaCrud()
        {
            Nome = _pesquisa.Nome,
        };

        var retorno = await ApiPesquisa.GravarAsync(comando, "api/pesquisas", PesquisaId.ToString());
        if (!retorno.Sucesso)
        {
            Snackbar.Add(retorno.Mensagem, Severity.Error);
            return;
        }
        
        if(!IsEditing)
            Navigation.NavigateTo($"pesquisa/{retorno.Data!.Id}");
        else
            StateHasChanged();
    }

    private Task RemoveGroup(GrupoQuestaoCrud group)
    {
        throw new NotImplementedException();
    }

    private Task AdicionarQuestao(GrupoQuestaoCrud group)
    {
        throw new NotImplementedException();
    }

    private Task RemoveQuestao(GrupoQuestaoCrud group, QuestaoCrud questao)
    {
        throw new NotImplementedException();
    }

}
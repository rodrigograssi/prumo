@page "/resultado/{PesquisaId:guid}/{PersonId:guid}"
@page "/resultados/{PesquisaId:guid}"
@using PesquisaX.Shared.Views
@using PesquisaX.Shared.Comandos
@using Microsoft.JSInterop

@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject HttpClient HttpClient
@inject IJSRuntime JS

@inject ApiControllerGenerico ApiController

<PageTitle>@(IsResultView ? $"Resultado - {_personResult?.NomePessoa}" : $"Resultados - {_pesquisa?.Nome}")</PageTitle>

@if (_pesquisa == null)
{
    <MudContainer>
        <MudProgressLinear Indeterminate="true" />
        <MudText Align="Align.Center" Class="mt-4">Carregando...</MudText>
    </MudContainer>
}
else if (IsResultView && _personResult != null)
{
    <!-- Visualização Individual do Resultado -->
    <div style="background: white; min-height: 100vh; padding: 0;">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Style="padding: 24px;">
            <!-- Cabeçalho para compartilhamento de tela -->
            <MudPaper Elevation="0" Class="pa-4 mb-6 text-center" Style="border-bottom: 2px solid #1976d2;">
                <MudText Typo="Typo.h3" Color="Color.Primary" Class="mb-2">
                    Resultado da Avaliação
                </MudText>
                <MudText Typo="Typo.h5" Class="mb-1">@_personResult.NomePessoa</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">
                    @_pesquisa.Nome - @_personResult.DataAvaliacao.ToString("dd/MM/yyyy HH:mm")
                </MudText>
            </MudPaper>

            <!-- Controle de exibição -->
            <MudPaper Elevation="1" Class="pa-4 mb-4">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.CompareArrows" Color="Color.Primary" />
                    <MudSwitch @bind-Value="@_mostrarComparacao" 
                              Color="Color.Primary"
                              Label="Mostrar resultado" />
                </MudStack>
            </MudPaper>

            <!-- Gráficos lado a lado -->
            <MudGrid Justify="Justify.Center">
                <!-- Gráfico Atual (sempre visível) -->
                @if (_mostrarComparacao)
                {
                    <MudItem xs="12" lg="@(_mostrarComparacao ? 6 : 8)">
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-4" Color="Color.Primary">
                                @(_mostrarComparacao ? "Situação Atual" : $"Resultado - {_personResult?.NomePessoa}")
                            </MudText>
                            <RadarChart Title=""
                                        Labels="@_chartLabels"
                                        Data="@_actualData"
                                        BorderColor="rgb(240, 5, 20)"
                                        BackgroundColor="rgba(240, 5, 20, 0.1)"
                                        ShowLegend="false"/>
                        </MudPaper>
                    </MudItem>
                }
                <!-- Gráfico Ideal (condicional) -->
   
                <MudItem xs="12" lg="6">
                    <MudPaper Elevation="2" Class="pa-4">
                        <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-4" Color="Color.Success">
                            Situação Ideal (100%)
                        </MudText>
                        <RadarChart Title=""
                                  Labels="@_chartLabels"
                                  Data="@_desiredData"
                                  BorderColor="rgb(76, 175, 80)"
                                  BackgroundColor="rgba(76, 175, 80, 0.1)"
                                  ShowLegend="false" />
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @if (_mostrarComparacao)
            {
                <!-- Detalhes por Grupo -->
                <MudPaper Elevation="1" Class="pa-4 mt-6">
                    <MudText Typo="Typo.h6" Class="mb-4">Detalhes por Categoria</MudText>
                    <MudGrid>
                        @foreach (var kvp in _groupoPorcentagens)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudCard Elevation="0" Style="border: 1px solid #e0e0e0;">
                                    <MudCardContent Class="text-center">
                                        <div style="width: 20px; height: 20px; background-color: @kvp.Cor; border-radius: 50%; margin: 0 auto 8px;"></div>
                                        <MudText Typo="Typo.subtitle1">@kvp.Categoria</MudText>
                                        <MudText Typo="Typo.h4" Color="Color.Primary">
                                            @kvp.Valor.ToString("0")%
                                        </MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            }
            <!-- Botões de ação -->
            <MudPaper Elevation="0" Class="pa-4 mt-6">
                <MudStack Row Justify="Justify.Center" Spacing="3">
                    <MudButton Variant="Variant.Text" 
                             StartIcon="@Icons.Material.Filled.ArrowBack"
                             OnClick="@(() => Navigation.NavigateTo($"/resultados/{PesquisaId}"))">
                        Ver Todos os Resultados
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" 
                             Color="Color.Secondary"
                             StartIcon="@Icons.Material.Filled.PictureAsPdf"
                             OnClick="@(() => ExportarPdf())">
                        Exportar PDF
                    </MudButton>
                    <MudButton Variant="Variant.Filled" 
                             Color="Color.Primary"
                             StartIcon="@Icons.Material.Filled.PlayArrow"
                             OnClick="@(() => Navigation.NavigateTo($"/aplicar-pesquisa/{PesquisaId}"))">
                        Nova Avaliação
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudContainer>
    </div>
}
else
{
    <!-- Lista de Todos os Resultados -->
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudPaper Elevation="2" Class="pa-4 mb-4">
            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h4">Resultados - @_pesquisa.Nome</MudText>
                <MudButton Variant="Variant.Filled" 
                         Color="Color.Primary" 
                         StartIcon="@Icons.Material.Filled.PlayArrow"
                         Href="@($"/aplicar-pesquisa/{PesquisaId}")">
                    Nova Aplicação
                </MudButton>
            </MudStack>
        </MudPaper>

        @if (_todosResultados?.Count == 0)
        {
            <MudPaper Elevation="1" Class="pa-8 text-center">
                <MudIcon Icon="@Icons.Material.Filled.Assessment" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
                <MudText Typo="Typo.h6" Class="mb-2">Nenhum resultado encontrado</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                    Aplique esta pesquisa para começar a ver resultados
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" 
                           Href="@($"/aplicar-pesquisa/{PesquisaId}")">
                    Aplicar Pesquisa
                </MudButton>
            </MudPaper>
        }
        else if (_todosResultados != null)
        {
            <MudGrid>
                @foreach (var result in _todosResultados.OrderByDescending(r => r.DataAvaliacao))
                {
                    <MudItem xs="12" md="6" lg="4">
                        <MudCard Elevation="2" Class="h-100">
                            <MudCardContent>
                                <MudStack>
                                    <MudText Typo="Typo.h6">@result.NomePessoa</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        @result.DataAvaliacao.ToString("dd/MM/yyyy HH:mm")
                                    </MudText>
                                    @if (!string.IsNullOrWhiteSpace(result.Email))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @result.Email
                                        </MudText>
                                    }
                                    
                                    <MudDivider />
                                    
                                    <MudText Typo="Typo.subtitle1">
                                        Média Geral: 
                                        <span style="color: @GetScoreColor(result.MediaGeral); font-weight: bold;">
                                            @result.MediaGeral.ToString("0")%
                                        </span>
                                    </MudText>
                                    
                                    <MudStack Spacing="1">
                                        @foreach (var kvp in result.PercentuaisGrupos)
                                        {
                                            <MudStack Row Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.body2">@kvp.Key:</MudText>
                                                <MudText Typo="Typo.body2" Style="@($"color: {GetScoreColor(kvp.Value)}; font-weight: 500;")">
                                                    @kvp.Value.ToString("0")%
                                                </MudText>
                                            </MudStack>
                                        }
                                    </MudStack>
                                </MudStack>
                            </MudCardContent>
                            <MudCardActions>
                                <MudButtonGroup Size="Size.Small" Variant="Variant.Text">
                                    <MudButton StartIcon="@Icons.Material.Filled.Visibility" Color="Color.Primary"
                                               OnClick="() => ViewIndividualResult(result.PublicId)">
                                        Ver Resultado
                                    </MudButton>
                                    <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                               OnClick="() => DeleteResult(result)">
                                        Excluir
                                    </MudButton>
                                </MudButtonGroup>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }

        <MudPaper Elevation="1" Class="pa-4 mt-4">
            <MudButton Variant="Variant.Text" 
                     StartIcon="@Icons.Material.Filled.ArrowBack"
                     OnClick="@(() => Navigation.NavigateTo("/pesquisas"))">
                Voltar para Pesquisas
            </MudButton>
        </MudPaper>
    </MudContainer>
}

@code {
    [Parameter] public Guid PesquisaId { get; set; }
    [Parameter] public Guid? PersonId { get; set; }

    private PesquisaResultadoView? _pesquisa;
    private RespostaPessoaView? _personResult;
    private List<RespostaPessoaView>? _todosResultados;
    
    //Percentages Média dos Grupos de Resposta da Pessoa Lista com (Nome da Categoria, Valor, Cor)
    private List<MediaDeResultadosDosGruposView> _groupoPorcentagens = [];
    private List<string> _chartLabels = new();
    private List<double> _actualData = new();
    private List<double> _desiredData = new();
    
    private bool _mostrarComparacao;

    private bool IsResultView => PersonId.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        var retorno = await ApiController.GetAsync<PesquisaResultadoView>($"api/Pesquisas/{PesquisaId}/resultado");
        if(!retorno.Sucesso || retorno.Data == null)
        {
            Snackbar.Add("Pesquisa não encontrada", Severity.Error);
            Navigation.NavigateTo("/pesquisas");
            return;
        }

        _pesquisa = retorno.Data;

        if (IsResultView && PersonId.HasValue)
        {
            var retornoPessoa = await ApiController.GetAsync<RespostaPessoaView>($"api/Pesquisas/{PesquisaId}/resultados/{PersonId}");
            if(!retornoPessoa.Sucesso || retornoPessoa.Data == null)
            {
                Snackbar.Add("Resultado não encontrado", Severity.Error);
                Navigation.NavigateTo($"/resultados/{PesquisaId}");
                return;
            }

            _personResult = retornoPessoa.Data;
            var retornoPorcentagesn = await ApiController.GetAsync<List<MediaDeResultadosDosGruposView>>($"api/Pesquisas/{PesquisaId}/resultados/{PersonId}/media");
            if(retornoPorcentagesn is { Sucesso: true, Data: not null }) 
              _groupoPorcentagens = retornoPorcentagesn.Data;
            
            PrepareChartData();
        }
        else
        {
            var retornoResultados = await ApiController.GetAsync<List<RespostaPessoaView>>($"api/Pesquisas/{PesquisaId}/resultados");
            if (retornoResultados is { Sucesso: true, Data: not null })
            {
                _todosResultados = retornoResultados.Data;
            }
        }
    }

    private void PrepareChartData()
    {
        if (_pesquisa == null || _personResult == null) return;


        _chartLabels = _groupoPorcentagens.Select(gp => gp.Categoria).ToList();
        _actualData =  _chartLabels
            .Select(label => _groupoPorcentagens
                .FirstOrDefault(gp => gp.Categoria == label)?.Valor ?? 0)
            .ToList();
        _desiredData = _chartLabels.Select(_ => 100.0).ToList();
    }

    private string GetScoreColor(double score)
    {
        return score switch
        {
            >= 80 => "#4caf50", // Verde
            >= 60 => "#ff9800", // Laranja
            >= 40 => "#f44336", // Vermelho
            _ => "#9e9e9e"       // Cinza
        };
    }

    private void ViewIndividualResult(Guid resultId)
    {
        Navigation.NavigateTo($"/resultado/{PesquisaId}/{resultId}");
    }

    private async Task DeleteResult(RespostaPessoaView result)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Confirmar Exclusão",
            $"Tem certeza que deseja excluir o resultado de '{result.NomePessoa}'? Esta ação não pode ser desfeita.",
            yesText: "Excluir",
            cancelText: "Cancelar");
            
        if (confirmed == true)
        {
            // Remove resultado da pesquisa
            // _pesquisa!.RespostasPessoa.Remove(result);
            // await ServicoPesquisa.AlterarPesquisaAsync(_pesquisa);
            
            // Recarrega a lista
            var retornoResultados = await ApiController.DeleteAsync($"api/Pesquisas/{PesquisaId}/resultados",result.PublicId.ToString() );
            if (retornoResultados.Sucesso)
            {
                Snackbar.Add("Resultado excluído com sucesso", Severity.Success);
                StateHasChanged();
                return;
            }
            Snackbar.Add(retornoResultados.Mensagem, Severity.Error);
        }
    }

    private async Task ExportarPdf()
    {
        if (PersonId == null || _personResult == null || _pesquisa == null) return;

        try
        {
           // Snackbar.Add("Capturando gráfico...", Severity.Info);
            
            // Capturar o gráfico como imagem base64 via JavaScript
            var chartImageBase64 = await JS.InvokeAsync<string>("captureRadarChart");
            
            if (string.IsNullOrEmpty(chartImageBase64))
            {
                Snackbar.Add("Erro ao capturar gráfico", Severity.Error);
                return;
            }

            // Criar comando para exportação
            var command = new ExportarPdfCommand
            {
                ChartImageBase64 = chartImageBase64,
                NomePessoa = _personResult.NomePessoa,
                NomePesquisa = _pesquisa.Nome,
                DataAvaliacao = _personResult.DataAvaliacao,
                DetalhesGrupos = _groupoPorcentagens
            };

            Snackbar.Add("Gerando PDF...", Severity.Info);

            // Enviar para API via POST para download
            var retorno = await ApiController.PostDownloadAsync(command, $"api/Pesquisas/{PesquisaId}/resultados/{PersonId}/pdf");
            
            if (retorno.Sucesso && retorno.Data != null)
            {
                // Fazer download do PDF
                var fileName = $"{_personResult.NomePessoa}_{_pesquisa.Nome}_Resultado_{DateTime.Now:yyyyMMdd}.pdf"
                    .Replace(" ", "_").Replace("/", "_").Replace("\\", "_");
                
                await JS.InvokeVoidAsync("downloadFile", retorno.Data, fileName, "application/pdf");
                Snackbar.Add("PDF exportado com sucesso!", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Erro ao gerar PDF: {retorno.Mensagem}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao exportar PDF: {ex.Message}", Severity.Error);
        }
    }
 
}


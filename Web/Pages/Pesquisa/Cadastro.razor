@page "/criar-pesquisa"
@page "/editar-pesquisa/{PesquisaId:guid}"

@using Microsoft.AspNetCore.Authorization
@using Prumo.Shared.Comandos
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ApiControllerGenerico ApiController
@inject IAService IAService
@inject IDialogService DialogService

@attribute [Authorize]

<PageTitle>@(IsEditing ? "Editar Pesquisa" : "Criar Nova Pesquisa")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.h4">@(IsEditing ? "Editar Pesquisa" : "Criar Nova Pesquisa")</MudText>
    </MudPaper>

    <MudForm @ref="_form" Model="_pesquisa" @bind-IsValid="_formIsValid">
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudStack>
                <MudTextField T="string" Label="Nome da Pesquisa"
                              @bind-Value="_pesquisa.Nome"
                              Required="true"
                              Variant="Variant.Outlined"
                              Class="mb-4" />

                <MudTextField T="string" Label="Nome do Resultado Desejado"
                              @bind-Value="_pesquisa.NomeResultadoDesejado"
                              Variant="Variant.Outlined"
                              Class="mb-4"
                              HelperText="Nome que aparecerá como referência de 100% no gráfico de resultados" />

                @if (!IsEditing && _iaDisponivel)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Class="mr-2" />
                        Agora você pode gerar pesquisas automaticamente com inteligência artificial!
                    </MudAlert>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.AutoAwesome"
                               OnClick="AbrirGeracaoIA"
                               Disabled="_gerandoComIA">
                        @if (_gerandoComIA)
                        {
                            <MudProgressCircular Color="Color.Default" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <text>Gerando com IA...</text>
                        }
                        else
                        {
                            <text>Gerar Pesquisa com IA</text>
                        }
                    </MudButton>
                }
                @* else if (!IsEditing && !_iaDisponivel) *@
                @* { *@
                @*     <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Class="mb-4"> *@
                @*         <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" /> *@
                @*         Geração por IA não disponível (configure a chave OpenAI na API) *@
                @*     </MudAlert> *@
                @* } *@
            </MudStack>
        </MudPaper>

        @foreach (var group in _pesquisa.GruposQuestoes)
        {
            <MudPaper Elevation="2" Class="pa-4 mb-4" Style="background: linear-gradient(135deg, #f8f9ff 0%, #e3f2fd 100%); border-left: 4px solid #2196f3;">
                <MudStack>
                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h6">Grupo de Perguntas</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                     Color="Color.Error"
                                     Size="Size.Small"
                                     OnClick="() => RemoveGroup(group)" />
                    </MudStack>

                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Nome do Grupo"
                                        @bind-Value="group.Nome"
                                        Required="true"
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Categoria (para gráfico)"
                                        @bind-Value="group.Categoria"
                                        Required="true"
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            @* <MudTextField T="string" Label="Cor (Hex)"  *@
                            @*             @bind-Value="group.Cor"  *@
                            @*             Variant="Variant.Outlined" *@
                            @*             Placeholder="#FF6B6B" /> *@
                            <MudColorPicker
                                Label="Cor do grupo"
                                @bind-Text="group.Cor"
                                Placeholder="Selecione uma cor"
                                ShowInputs="false"
                                ShowToolbar="true"
                                ShowAlpha="false"
                                />
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-2" />

                    <MudText Typo="Typo.subtitle1">Perguntas:</MudText>

                    @foreach (var question in group.Questoes)
                    {
                        <MudPaper Elevation="0" Class="pa-3 mb-2" Style="border: 1px dashed #ddd;">
                            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudTextField T="string" Label="Pergunta"
                                            @bind-Value="question.Texto"
                                            Required="true"
                                            Variant="Variant.Text"
                                            Style="flex-grow: 1; margin-right: 16px;" />

                                <MudCheckBox T="bool" Label="Escala Invertida (10 = ruim)"
                                           @bind-Value="question.EInvertida"
                                           Color="Color.Primary" />

                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                             Color="Color.Error"
                                             Size="Size.Small"
                                             OnClick="() => RemoveQuestao(group, question)" />
                            </MudStack>
                        </MudPaper>
                    }

                    <MudButton Variant="Variant.Text"
                             Color="Color.Primary"
                             StartIcon="@Icons.Material.Filled.Add"
                             OnClick="() => AddQuestao(group)">
                        Adicionar Pergunta
                    </MudButton>
                </MudStack>
            </MudPaper>
        }

        <MudPaper Elevation="1" Class="pa-4 mb-4 text-center">
            <MudButton Variant="Variant.Outlined"
                     Color="Color.Success"
                     StartIcon="@Icons.Material.Filled.Add"
                     OnClick="AddGroup">
                Adicionar Grupo de Perguntas
            </MudButton>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudStack Row Justify="Justify.SpaceBetween">
                <MudButton Variant="Variant.Text"
                         StartIcon="@Icons.Material.Filled.ArrowBack"
                         OnClick="GoBack">
                    Voltar
                </MudButton>

                <MudButtonGroup>
                    <MudButton Variant="Variant.Filled"
                             Color="Color.Primary"
                             Disabled="@(!_formIsValid || _pesquisa.GruposQuestoes.Count == 0)"
                             OnClick="SavePesquisa">
                        @(IsEditing ? "Salvar Alterações" : "Criar Pesquisa")
                    </MudButton>
                </MudButtonGroup>
            </MudStack>
        </MudPaper>
    </MudForm>
</MudContainer>

@code {
    [Parameter] public Guid? PesquisaId { get; set; }

    private MudForm _form = new();
    private bool _formIsValid;
    private PesquisaCrud _pesquisa = new();
    private bool _iaDisponivel;
    private bool _gerandoComIA;

    private bool IsEditing => PesquisaId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        // Verificar se IA está disponível
        //_iaDisponivel = await IAService.EstaDisponivel();
        _iaDisponivel = false;

        if (IsEditing && PesquisaId.HasValue)
        {
            var retorno = await ApiController.GetAsync<PesquisaCrud>($"api/Pesquisas/{PesquisaId.ToString()}");
            if (retorno is { Sucesso: true, Data: not null })
                _pesquisa = retorno.Data;
            else
                Navigation.NavigateTo("/pesquisas");
        }

        // Garantir que há pelo menos um grupo
        if (_pesquisa.GruposQuestoes.Count == 0)
            AddGroup();
    }

    private void AddGroup()
    {
        var ordem = _pesquisa.GruposQuestoes.Count;
        
        _pesquisa.GruposQuestoes.Add(new GrupoQuestaoCrud
        {
            Ordem = ordem,
            Nome = "",
            Categoria = "",
            Cor = "#FF6B6B"
        });
    }

    private void RemoveGroup(GrupoQuestaoCrud group)
    {
        if (_pesquisa.GruposQuestoes.Count > 1)
            _pesquisa.GruposQuestoes.Remove(group);
    }

    private void AddQuestao(GrupoQuestaoCrud group)
    {
        var ordem = group.Questoes.Count; 
        group.Questoes.Add(new QuestaoCrud
        {
            Ordem = ordem,
            Texto = "",
            EInvertida = false
        });
    }

    private void RemoveQuestao(GrupoQuestaoCrud group, QuestaoCrud question)
    {
        group.Questoes.Remove(question);
    }

    private async Task SavePesquisa()
    {
        // Validar se todos os grupos têm pelo menos uma pergunta
        var emptyGroups = _pesquisa.GruposQuestoes.Where(g => g.Questoes.Count == 0).ToList();
        if (emptyGroups.Any())
        {
            Snackbar.Add("Todos os grupos devem ter pelo menos uma pergunta", Severity.Warning);
            return;
        }

        try
        {
            var retorno = await ApiController.GravarAsync(_pesquisa, "api/Pesquisas", PesquisaId.ToString());
            if (retorno.Sucesso)
            {
                Snackbar.Add(IsEditing ? "Pesquisa atualizada com sucesso" : "Pesquisa criada com sucesso", Severity.Success);
                Navigation.NavigateTo("/pesquisas");
                return;
            }

            Snackbar.Add(retorno.Mensagem, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao salvar pesquisa: {ex.Message}", Severity.Error);
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/pesquisas");
    }

    private async Task AbrirGeracaoIA()
    {
        var parameters = new DialogParameters<DialogGeracaoIA>
        {
            { x => x.IAService, IAService },
            { x => x.ApiController, ApiController }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<DialogGeracaoIA>("Gerar Pesquisa com IA", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is PesquisaCrud pesquisaGerada)
        {
            _pesquisa = pesquisaGerada;
            StateHasChanged();
            Snackbar.Add("Pesquisa gerada com sucesso! Revise e ajuste conforme necessário.", Severity.Success);
        }
    }
}
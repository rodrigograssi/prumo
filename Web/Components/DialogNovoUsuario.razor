@using PesquisaX.Shared.DTO.Requestes
@inject IUsuarioService UsuarioService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudTextField @bind-Value="registroRequest.Nome"
                         Label="Nome Completo"
                         Variant="Variant.Outlined"
                         Required="true"
                         RequiredError="Nome é obrigatório"
                         Counter="100"
                         MaxLength="100"
                         Class="mb-4" />
            
            <MudTextField @bind-Value="registroRequest.Email"
                         Label="Email"
                         Variant="Variant.Outlined"
                         InputType="InputType.Email"
                         Required="true"
                         RequiredError="Email é obrigatório"
                         Validation="@(new EmailAddressAttribute() {ErrorMessage = "Email deve ter um formato válido"})"
                         Class="mb-4" />
            
            <MudTextField @bind-Value="registroRequest.Senha"
                         Label="Senha"
                         Variant="Variant.Outlined"
                         InputType="InputType.Password"
                         Required="true"
                         RequiredError="Senha é obrigatória"
                         Validation="@(new Func<string, string?>(ValidarSenha))"
                         Class="mb-4" />
            
            <MudTextField @bind-Value="registroRequest.ConfirmarSenha"
                         Label="Confirmar Senha"
                         Variant="Variant.Outlined"
                         InputType="InputType.Password"
                         Required="true"
                         RequiredError="Confirmação de senha é obrigatória"
                         Validation="@(new Func<string, string?>(ValidarConfirmacaoSenha))"
                         Class="mb-4" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="CriarUsuario"
                   Disabled="carregando">
            @if (carregando)
            {
                <MudProgressCircular Class="ms-n1 mr-2" Size="Size.Small" Indeterminate="true"/>
                <span>Criando...</span>
            }
            else
            {
                <span>Criar Usuário</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance  MudDialog { get; set; } = default!;
    
    private MudForm form = new();
    private RegistroRequest registroRequest = new();
    private bool carregando = false;

    private void Cancelar() => MudDialog?.Cancel();

    private async Task CriarUsuario()
    {
        await form.Validate();
        if (!form.IsValid) return;

        carregando = true;
        StateHasChanged();

        try
        {
            var usuario = await UsuarioService.CriarUsuarioAsync(registroRequest);
            Snackbar.Add($"Usuário '{usuario.Nome}' criado com sucesso!", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(usuario));
        }
        catch (HttpRequestException ex) when (ex.Message.Contains("400"))
        {
            Snackbar.Add("Email já está em uso ou dados inválidos", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao criar usuário: {ex.Message}", Severity.Error);
        }
        finally
        {
            carregando = false;
            StateHasChanged();
        }
    }

    private string? ValidarSenha(string senha)
    {
        if (string.IsNullOrWhiteSpace(senha))
            return "Senha é obrigatória";
        
        if (senha.Length < 6)
            return "Senha deve ter no mínimo 6 caracteres";
        
        return null;
    }

    private string? ValidarConfirmacaoSenha(string confirmacao)
    {
        if (string.IsNullOrWhiteSpace(confirmacao))
            return "Confirmação de senha é obrigatória";
        
        if (confirmacao != registroRequest.Senha)
            return "Senhas não conferem";
        
        return null;
    }
}
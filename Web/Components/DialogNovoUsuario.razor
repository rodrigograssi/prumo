@using PesquisaX.Shared.Comandos
@inject ISnackbar Snackbar
@inject ApiController<dynamic> ApiUser

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_comandoCriarUsuario.Nome"
                         Label="Nome Completo"
                         Variant="Variant.Outlined"
                         Required="true"
                         RequiredError="Nome é obrigatório"
                         Counter="100"
                         MaxLength="100"
                         Class="mb-4" />
            
            <MudTextField @bind-Value="_comandoCriarUsuario.Email"
                         Label="Email"
                         Variant="Variant.Outlined"
                         InputType="InputType.Email"
                         Required="true"
                         RequiredError="Email é obrigatório"
                         Validation="@(new EmailAddressAttribute() {ErrorMessage = "Email deve ter um formato válido"})"
                         Class="mb-4" />
            
            <MudTextField @bind-Value="_comandoCriarUsuario.Senha"
                         Label="Senha"
                         Variant="Variant.Outlined"
                         InputType="InputType.Password"
                         Required="true"
                         RequiredError="Senha é obrigatória"
                         Validation="@(new Func<string, string?>(ValidarSenha))"
                         Class="mb-4" />
            
            <MudTextField @bind-Value="_comandoCriarUsuario.ConfirmarSenha"
                         Label="Confirmar Senha"
                         Variant="Variant.Outlined"
                         InputType="InputType.Password"
                         Required="true"
                         RequiredError="Confirmação de senha é obrigatória"
                         Validation="@(new Func<string, string?>(ValidarConfirmacaoSenha))"
                         Class="mb-4" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="CriarUsuario"
                   Disabled="_carregando">
            @if (_carregando)
            {
                <MudProgressCircular Class="ms-n1 mr-2" Size="Size.Small" Indeterminate="true"/>
                <span>Criando...</span>
            }
            else
            {
                <span>Criar Usuário</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance  MudDialog { get; set; } = default!;
    
    private MudForm _form = new();
    private UsuarioCrud _comandoCriarUsuario = new();
    private bool _carregando;

    private void Cancelar() => MudDialog.Cancel();

    private async Task CriarUsuario()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        _carregando = true;
        StateHasChanged();

        try
        {
            var retorno = await ApiUser.PostAsync(_comandoCriarUsuario, "api/usuarios");
            if (!retorno.Sucesso)
            {
                Snackbar.Add($"{retorno.Mensagem}", Severity.Error);
                return;
            }
            
            Snackbar.Add($"Usuário '{_comandoCriarUsuario.Nome}' criado com sucesso!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(_comandoCriarUsuario));
        }
        catch (HttpRequestException ex) when (ex.Message.Contains("400"))
        {
            Snackbar.Add("Email já está em uso ou dados inválidos", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao criar usuário: {ex.Message}", Severity.Error);
        }
        finally
        {
            _carregando = false;
            StateHasChanged();
        }
    }

    private string? ValidarSenha(string senha)
    {
        if (string.IsNullOrWhiteSpace(senha))
            return "Senha é obrigatória";
        
        if (senha.Length < 6)
            return "Senha deve ter no mínimo 6 caracteres";
        
        return null;
    }

    private string? ValidarConfirmacaoSenha(string confirmacao)
    {
        if (string.IsNullOrWhiteSpace(confirmacao))
            return "Confirmação de senha é obrigatória";
        
        if (confirmacao != _comandoCriarUsuario.Senha)
            return "Senhas não conferem";
        
        return null;
    }
}
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div style="position: relative; width: 100%; height: 400px;">
    <canvas id="@CanvasId" style="max-width: 100%; max-height: 100%;"></canvas>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public List<string> Labels { get; set; } = new();
    [Parameter] public List<double> Data { get; set; } = new();
    [Parameter] public string BorderColor { get; set; } = "rgb(255, 99, 132)";
    [Parameter] public string BackgroundColor { get; set; } = "rgba(255, 99, 132, 0.2)";
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public int MaxValue { get; set; } = 100;

    private string CanvasId = $"chart_{Guid.NewGuid():N}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Labels.Any() && Data.Any())
        {
            _hasRendered = true;
            await CreateChart();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Só recria o chart se ainda não foi renderizado
        if (Labels.Any() && Data.Any() && !_hasRendered)
        {
            StateHasChanged();
        }
    }

    private bool _hasRendered = false;

    private async Task CreateChart()
    {
        try
        {
            // Aguardar um pouco para garantir que o DOM está pronto
            await Task.Delay(100);
            
            var data = new
            {
                labels = Labels,
                datasets = new[]
                {
                    new
                    {
                        label = Title,
                        data = Data,
                        borderColor = BorderColor,
                        backgroundColor = BackgroundColor,
                        borderWidth = 2,
                        pointBackgroundColor = BorderColor,
                        pointBorderColor = "#fff",
                        pointHoverBackgroundColor = "#fff",
                        pointHoverBorderColor = BorderColor,
                        pointRadius = 4,
                        pointHoverRadius = 6
                    }
                }
            };

            var options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                plugins = new
                {
                    legend = new
                    {
                        display = ShowLegend,
                        position = "top"
                    },
                    title = new
                    {
                        display = !string.IsNullOrEmpty(Title),
                        text = Title,
                        font = new { size = 16, weight = "bold" }
                    }
                },
                scales = new
                {
                    r = new
                    {
                        beginAtZero = true,
                        max = MaxValue,
                        ticks = new
                        {
                            stepSize = 20
                        },
                        grid = new
                        {
                            color = "rgba(0, 0, 0, 0.1)"
                        },
                        angleLines = new
                        {
                            color = "rgba(0, 0, 0, 0.1)"
                        }
                    }
                }
            };

            var result = await JSRuntime.InvokeAsync<bool>("chartFunctions.createRadarChart", CanvasId, data, options);
            
            if (!result)
            {
                Console.WriteLine($"Falha ao criar gráfico para canvas: {CanvasId}");
            }
            else
            {
                Console.WriteLine($"Gráfico criado com sucesso para canvas: {CanvasId}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao criar gráfico: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("chartFunctions.destroyChart", CanvasId);
        }
        catch
        {
            // Ignore errors during disposal
        }
    }

    public async Task UpdateChart()
    {
        await CreateChart();
    }
}
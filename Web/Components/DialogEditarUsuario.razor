@using PesquisaX.Shared.Comandos
@inject ISnackbar Snackbar
@inject ApiController ApiUser

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_usuarioEditado.Nome"
                         Label="Nome Completo"
                         Variant="Variant.Outlined"
                         Required="true"
                         RequiredError="Nome é obrigatório"
                         Counter="100"
                         MaxLength="100"
                         Class="mb-4" />
            
            <MudTextField @bind-Value="_usuarioEditado.Email"
                         Label="Email"
                         Variant="Variant.Outlined"
                         InputType="InputType.Email"
                         Required="true"
                         RequiredError="Email é obrigatório"
                         Validation="@(new EmailAddressAttribute() {ErrorMessage = "Email deve ter um formato válido"})"
                         Class="mb-4" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="SalvarUsuario"
                   Disabled="_carregando">
            @if (_carregando)
            {
                <MudProgressCircular Class="ms-n1 mr-2" Size="Size.Small" Indeterminate="true"/>
                <span>Salvando...</span>
            }
            else
            {
                <span>Salvar</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance  MudDialog { get; set; } = default!;
    [Parameter] public UsuarioCrud Usuario { get; set; } = null!;
    
    private MudForm _form = new();
    private UsuarioCrud _usuarioEditado = new();
    private bool _carregando;

    protected override void OnInitialized()
    {
        _usuarioEditado = new UsuarioCrud
        {
            Id = Usuario.Id,
            Nome = Usuario.Nome,
            Email = Usuario.Email
        };
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task SalvarUsuario()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        _carregando = true;
        StateHasChanged();

        try
        {
            var retorno = await ApiUser.GravarAsync(_usuarioEditado, $"api/usuarios", _usuarioEditado.Id);
            if (!retorno.Sucesso)
            {
                Snackbar.Add($"{retorno.Mensagem}", Severity.Error);
                return;
            }
            Snackbar.Add($"Usuário '{_usuarioEditado.Nome}' atualizado com sucesso!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(_usuarioEditado));
        }
        catch (HttpRequestException ex) when (ex.Message.Contains("400"))
        {
            Snackbar.Add("Email já está em uso ou dados inválidos", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao atualizar usuário: {ex.Message}", Severity.Error);
        }
        finally
        {
            _carregando = false;
            StateHasChanged();
        }
    }
}
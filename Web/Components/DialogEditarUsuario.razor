@using PesquisaX.Shared
@using MudBlazor
@using MudBlazor.Services
@inject IUsuarioService UsuarioService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudTextField @bind-Value="usuarioEditado.Nome"
                         Label="Nome Completo"
                         Variant="Variant.Outlined"
                         Required="true"
                         RequiredError="Nome é obrigatório"
                         Counter="100"
                         MaxLength="100"
                         Class="mb-4" />
            
            <MudTextField @bind-Value="usuarioEditado.Email"
                         Label="Email"
                         Variant="Variant.Outlined"
                         InputType="InputType.Email"
                         Required="true"
                         RequiredError="Email é obrigatório"
                         Validation="@(new EmailAddressAttribute() {ErrorMessage = "Email deve ter um formato válido"})"
                         Class="mb-4" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="SalvarUsuario"
                   Disabled="carregando">
            @if (carregando)
            {
                <MudProgressCircular Class="ms-n1 mr-2" Size="Size.Small" Indeterminate="true"/>
                <span>Salvando...</span>
            }
            else
            {
                <span>Salvar</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance  MudDialog { get; set; } = default!;
    [Parameter] public Usuario Usuario { get; set; } = null!;
    
    private MudForm form = new();
    private Usuario usuarioEditado = new();
    private bool carregando = false;

    protected override void OnInitialized()
    {
        usuarioEditado = new Usuario
        {
            Id = Usuario.Id,
            Nome = Usuario.Nome,
            Email = Usuario.Email,
            DataCriacao = Usuario.DataCriacao
        };
    }

    private void Cancelar() => MudDialog?.Cancel();

    private async Task SalvarUsuario()
    {
        await form.Validate();
        if (!form.IsValid) return;

        carregando = true;
        StateHasChanged();

        try
        {
            var usuario = await UsuarioService.AtualizarUsuarioAsync(usuarioEditado.Id, usuarioEditado);
            Snackbar.Add($"Usuário '{usuario.Nome}' atualizado com sucesso!", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(usuario));
        }
        catch (HttpRequestException ex) when (ex.Message.Contains("400"))
        {
            Snackbar.Add("Email já está em uso ou dados inválidos", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao atualizar usuário: {ex.Message}", Severity.Error);
        }
        finally
        {
            carregando = false;
            StateHasChanged();
        }
    }
}
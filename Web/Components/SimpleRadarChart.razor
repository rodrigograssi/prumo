@inject IJSRuntime JSRuntime

<div style="position: relative; width: 100%; height: 400px; border: 1px dashed #ccc;">
    <canvas id="@CanvasId" width="400" height="400"></canvas>
    
    @if (_isDebugMode)
    {
        <div style="margin-top: 10px;">
            <MudText Typo="Typo.caption">Debug Info:</MudText>
            <MudText Typo="Typo.caption">Canvas ID: @CanvasId</MudText>
            <MudText Typo="Typo.caption">Labels Count: @Labels.Count</MudText>
            <MudText Typo="Typo.caption">Data Count: @Data.Count</MudText>
            <MudText Typo="Typo.caption">Labels: @string.Join(", ", Labels)</MudText>
            <MudText Typo="Typo.caption">Data: @string.Join(", ", Data)</MudText>
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public List<string> Labels { get; set; } = new();
    [Parameter] public List<double> Data { get; set; } = new();
    [Parameter] public string BorderColor { get; set; } = "rgb(255, 99, 132)";
    [Parameter] public string BackgroundColor { get; set; } = "rgba(255, 99, 132, 0.2)";
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public int MaxValue { get; set; } = 100;

    private string CanvasId = $"chart_{Guid.NewGuid():N}";
    private bool _isDebugMode = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(500); // Aguardar mais tempo
            await CreateSimpleChart();
        }
    }

    private async Task CreateSimpleChart()
    {
        try
        {
            Console.WriteLine($"Tentando criar gráfico simples para canvas: {CanvasId}");
            Console.WriteLine($"Labels: {string.Join(", ", Labels)}");
            Console.WriteLine($"Data: {string.Join(", ", Data)}");

            var data = new
            {
                labels = Labels.ToArray(),
                datasets = new[]
                {
                    new
                    {
                        label = Title,
                        data = Data.ToArray(),
                        borderColor = BorderColor,
                        backgroundColor = BackgroundColor,
                        borderWidth = 2
                    }
                }
            };

            var options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                scales = new
                {
                    r = new
                    {
                        beginAtZero = true,
                        max = MaxValue
                    }
                }
            };

            var success = await JSRuntime.InvokeAsync<bool>("chartFunctions.createRadarChart", CanvasId, data, options);
            Console.WriteLine($"Resultado da criação do gráfico: {success}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao criar gráfico simples: {ex}");
        }
    }
}
@inherits LayoutComponentBase

@using ControleDeIp.FrontEnd.Services
@using Microsoft.AspNetCore.Authorization
@using PesquisaX.Shared.Version
@using PesquisaX.Shared.Views
@using PesquisaX.Web.Dto

@inject IServicoTema ServicoTema
@inject NavigationManager Navigation
@inject ApiUsuarioController ApiUsuarioController

@implements IDisposable

@attribute [Authorize]

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudSpacer />
        <MudText Typo="Typo.h6">Pesquisa X</MudText>
        <MudSpacer />
        <MudTooltip Text="@(ServicoTema.EModoEscuro ? "Modo Claro" : "Modo Escuro")">
            <MudIconButton Icon="@(ServicoTema.EModoEscuro ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" 
                         Color="Color.Inherit" 
                         OnClick="ToggleTheme" />
        </MudTooltip>
        
        @if (_usuarioAtual != null)
        {
            <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit">
                <MudMenuItem OnClick="@(() => Navigation.NavigateTo("/perfil"))">
                    <div style="display: flex; align-items: center;">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" />
                        @_usuarioAtual.Nome
                    </div>
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem OnClick="RealizarLogout">
                    <div style="display: flex; align-items: center;">
                        <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-2" />
                        Sair
                    </div>
                </MudMenuItem>
            </MudMenu>
        }
        else if (!_isLoading)
        {
            <!-- Fallback caso haja problemas na verificação -->
            <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" 
                          Color="Color.Inherit" 
                          OnClick="@(() => Navigation.NavigateTo("/"))" />
        }
    </MudAppBar>
    
    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="@DrawerVariant.Temporary" ClipMode="DrawerClipMode.Always">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Menu</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>
    
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-16">
            @Body
        </MudContainer>
        
        <!-- Footer com informações de versão -->
        <MudPaper Elevation="0" 
                 Class="pa-3 mt-4" 
                 Style="position: fixed; bottom: 0; width: 100%; z-index: 1000; background: var(--mud-palette-surface); border-top: 1px solid var(--mud-palette-divider);">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge">
                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @AppVersion.Copyright
                    </MudText>
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @AppVersion.DetailedVersion
                        </MudText>
                        <MudTooltip Text="Ver histórico de mudanças">
                            <MudIconButton Icon="@Icons.Material.Filled.Timeline" 
                                         Size="Size.Small" 
                                         Color="Color.Secondary"
                                         OnClick="@(() => Navigation.NavigateTo("/changelog"))" />
                        </MudTooltip>
                    </MudStack>
                </MudStack>
            </MudContainer>
        </MudPaper>
    </MudMainContent>
    
    <!-- Botão de instalação PWA -->
    <InstallPwaButton />
</MudLayout>

@code {
    bool _drawerOpen = false;
    bool _isLoading = true;
    UsuarioView? _usuarioAtual = null;

    protected override async Task OnInitializedAsync()
    {
        await ServicoTema.InicializarAsync();
        ServicoTema.AoMudarTema += StateHasChanged;
        
        // Carregar dados do usuário (se chegou até aqui, está autenticado)
        await CarregarUsuario();
    }

    private async Task CarregarUsuario()
    {
        try
        {
            _usuarioAtual = ConfiguracoesWeb.UsuarioLogado;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar usuário: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    async Task ToggleTheme()
    {
        await ServicoTema.AlternarTemaAsync();
    }

    private async Task RealizarLogout()
    {
        await ApiUsuarioController.LogoutAsync();
        _usuarioAtual = null;
        Navigation.NavigateTo("/", replace: true);
    }

    public void Dispose()
    {
        ServicoTema.AoMudarTema -= StateHasChanged;
    }
}

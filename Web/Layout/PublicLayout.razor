@inherits LayoutComponentBase
@using MudBlazor

<div class="page">
    <main>
        <div class="top-row px-4">
            <MudAppBar Elevation="1" Color="Color.Primary">
                <MudText Typo="Typo.h6">PesquisaX - Visualização Pública</MudText>
                <MudSpacer />
                <MudIcon Icon="Icons.Material.Filled.Public" />
            </MudAppBar>
        </div>

        <article class="content px-4" style="margin-top: 64px;">
            @Body
        </article>
    </main>
</div>

<style>
    .page {
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .top-row {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
    }

    .content {
        flex: 1;
        padding-top: 20px;
        padding-bottom: 20px;
    }

    @@media (max-width: 640.98px) {
        .top-row {
            justify-content: space-between;
        }
    }
</style>